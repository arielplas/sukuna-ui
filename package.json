{
  "name": "sukuna-ui-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "tokens:build": "bun run --filter @sukunagg/ui tokens:build",
    "docs:build": "bun run scripts/build-docs.ts",
    "docs:check": "bun run scripts/check-docs.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check . && tsc --noEmit",
    "check:pkg": "bun run --filter './packages/*' check:pkg",
    "test": "bun run --filter './packages/*' test",
    "test:coverage": "bun run --filter './packages/*' test:coverage",
    "test:react18": "bun run scripts/with-react.ts 18 -- bun run test",
    "test:browser": "bun run storybook:build && playwright test",
    "size": "bun run --filter './packages/*' size",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "^2.2.0",
    "@changesets/cli": "^2.29.0",
    "@happy-dom/global-registrator": "^20.14.5",
    "@playwright/test": "^1.63.0",
    "@size-limit/preset-small-lib": "^14.0.0",
    "@storybook/addon-a11y": "^10",
    "@storybook/addon-docs": "^10",
    "@storybook/react-vite": "^10",
    "@tailwindcss/cli": "^4",
    "@tailwindcss/vite": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.2",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-core": "^4.13.0",
    "esbuild-plugin-preserve-directives": "^0.0.11",
    "hls.js": "^1.7.3",
    "jest-axe": "^11.0.0",
    "playwright": "^1.63.0",
    "publint": "^0.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "size-limit": "^14.0.0",
    "storybook": "^10",
    "tailwindcss": "^4",
    "tsup": "^8.5.0",
    "typescript": "^5.7.0",
    "vite": "^7"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.1.0"
  }
}
